# Optional workflow: install in .github/workflows only with workflow permission.
name: Custom LDO guide
on:
  push:
    branches: [Voron2.4]
    paths: ['docs/custom-build/**', '.github/workflows/custom-guide.yml']
  workflow_dispatch:
permissions:
  contents: read
  pages: write
  id-token: write
concurrency:
  group: custom-guide-pages
  cancel-in-progress: false
jobs:
  build:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4 pin
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5 pin
        with:
          python-version: '3.10.12'
      - run: python -m pip install -r docs/custom-build/requirements.txt
      - run: python docs/custom-build/tools/build.py
      - run: python docs/custom-build/tools/check.py
      - uses: actions/upload-pages-artifact@56afc609e74202658d3ffba0e8f6dda462b719fa # v3 pin
        with:
          path: docs/custom-build/site
  deploy:
    needs: build
    runs-on: ubuntu-24.04
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Publish checked guide
        id: deployment
        uses: actions/deploy-pages@d6db90164ac5ed86f2b6aed7e0febac5b3c0c03e # v4 pin
